{
  "_comment": "glm53-supervisor config for host-8chip (TP8 standing server). Copy to /opt/glm53/work-s9/supervisor/supervisor.json and edit. Paths follow the current tooling: tt-lock in ~/.tt-locks, the reset marker that trig_reset.sh / chain_reset.sh consume, the coordinator's request file.",
  "server_cmd": "bash /opt/glm53/srv/supervisor/bin/serve_cmd.host-8chip.sh",
  "run_root": "/opt/glm53/work-s9/supervisor",
  "host": "127.0.0.1",
  "port": 8000,
  "listen": "127.0.0.1:9108",
  "api_marker": "vllm.entrypoints.openai.api_server",
  "selftest_from_log": true,
  "selftest_cmd": null,
  "selftest_timeout_s": 900,
  "reset_group": "all",
  "reset_marker": "/opt/glm53/RESET_PENDING.all",
  "reset_cmd": null,
  "reset_journal": "/opt/glm53/home/.tt-locks/reset.journal",
  "reset_done_files": ["/opt/glm53/work-s9/COORDINATOR_NOTE.txt"],
  "lock_dir": "/opt/glm53/home/.tt-locks",
  "escalation_marker": "/opt/glm53/work-s9/supervisor/SUPERVISOR_ESCALATION",
  "coordinator_request": "/opt/glm53/work-s9/COORDINATOR_REQUEST.txt",
  "kernel_cmd": ["journalctl", "-k", "--since", "@{since}", "--no-pager", "-o", "short-iso"],
  "kernel_scan_s": 30,
  "scrape_s": 10,
  "health_probe_s": 5,
  "health_timeout_s": 5,
  "tick_s": 1,
  "env": {},
  "policy": {
    "max_failures": 2,
    "failure_window_s": 1800,
    "restart_delay_s": 5,
    "refused_retry_s": 60,
    "early_exit_s": 120,
    "stall_s": 330,
    "health_fail_s": 60,
    "fault_exit_grace_s": 120,
    "exit_grace_s": 900,
    "startup_timeout_s": 1800,
    "reset_settle_s": 0,
    "unclean_close_is_fault": true
  }
}
